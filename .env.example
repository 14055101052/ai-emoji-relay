# This is a template. Set EMOJI_API_KEY only in the host's server secret store.
# Never place the real value in this file, source control, chat, Android Gradle properties, or an APK.
EMOJI_API_KEY=
# Required server-side upstream configuration; no fallback is used.
LOVABLE_GENERATE_URL=https://project--a55e5977-6867-4325-9a5e-5e9efbb3a82c-dev.lovable.app/api/public/emoji/generate
HOST=127.0.0.1
PORT=8787
TLS_TERMINATION=reverse-proxy
RELAY_DB_PATH=/var/lib/ai-emoji-relay/relay.sqlite
GENERATION_DAILY_GLOBAL=50
GENERATION_DAILY_IP=5
MAX_CONCURRENT_GENERATIONS=2
# For direct HTTPS instead: unset TLS_TERMINATION and set TLS_CERT_FILE / TLS_KEY_FILE to server-only certificate paths.
# For Render Free, use the dashboard (see deploy/RENDER.md), replace the values above:
# TLS_TERMINATION=render
# NODE_ENV=development
# RELAY_STORAGE_MODE=ephemeral-development
# RELAY_DB_PATH=/tmp/ai-emoji-relay/relay.sqlite
# HOST must be unset (or 0.0.0.0); PORT and RENDER are injected by Render.
# For production: attach a persistent disk, set NODE_ENV=production,
# RELAY_STORAGE_MODE=persistent, and RELAY_DB_PATH to an absolute path on that disk.
